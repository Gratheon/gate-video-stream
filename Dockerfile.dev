FROM node:25-alpine

WORKDIR /app

ENV NODE_ENV=development

# Runtime dependency for fluent-ffmpeg
RUN apk add --no-cache ffmpeg \
  && npm install -g pnpm@10.29.2 \
  && mkdir -p /app/tmp

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

EXPOSE 8900
EXPOSE 8950

CMD ["pnpm", "run", "dev"]
