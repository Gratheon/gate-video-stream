{
  "name": "gate-video-stream",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.js",
  "dependencies": {
    "@apollo/federation": "0.33.0",
    "@databases/mysql": "7.0.0",
    "@databases/mysql-schema-cli": "1.1.1",
    "@databases/mysql-typed": "1.0.0",
    "@fastify/cors": "8.5.0",
    "@fastify/multipart": "9.4.0",
    "@gratheon/log-lib": "2.2.7",
    "@sendgrid/mail": "8.1.6",
    "@sentry/node": "10.42.0",
    "@sentry/tracing": "7.26.0",
    "apollo-server-core": "3.13.0",
    "apollo-server-fastify": "3.13.0",
    "aws-sdk": "2.1693.0",
    "cross-fetch": "4.0.0",
    "fast-safe-stringify": "2.1.1",
    "fastify": "4.29.1",
    "fluent-ffmpeg": "2.1.2",
    "form-data": "4.0.5",
    "graphql": "15.10.1",
    "graphql-tag": "2.12.6",
    "graphql-upload": "13.0.0",
    "ioredis": "5.3.2",
    "jsonwebtoken": "9.0.3",
    "jwt-encode": "1.0.1",
    "mysql2": "3.16.2",
    "node-fetch": "2.7.0",
    "sha1": "1.1.1",
    "stripe": "8.211.0"
  },
  "scripts": {
    "build": "tsc -p ./src/config/tsconfig.json",
    "test": "jest --config ./test/unit/jest.coverage.json",
    "test-integration": "jest --config ./test/integration/jest.coverage.json",
    "dev": "tsc-watch --project ./src/config/tsconfig.json --onSuccess \"node ./app/gate-video-stream.js\"",
    "prestart": "sh -c 'if [ ! -f /app/app/gate-video-stream.js ]; then echo \"gate-video-stream.js missing, running build\"; pnpm run build; fi'",
    "start": "ENV_ID=prod node /app/app/gate-video-stream.js",
    "generate-db-schema": "pnpm exec @databases/mysql-schema-cli --database mysql://root:test@localhost:5100/ --schemaName gate-video-stream --directory app/models/__generated__"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/gratheon/gate-video-stream.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/gratheon/gate-video-stream/issues"
  },
  "homepage": "https://github.com/gratheon/gate-video-stream#readme",
  "engines": {
    "node": ">=25.0.0"
  },
  "packageManager": "pnpm@10.29.2",
  "devDependencies": {
    "@types/form-data": "2.5.2",
    "@types/jest": "30.0.0",
    "@types/node": "25.3.3",
    "jest": "29.3.1",
    "tap": "21.6.2",
    "ts-jest": "29.0.3",
    "tsc-watch": "5.0.3",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "mysql2": "3.16.2",
      "xml2js": "0.6.2",
      "busboy": "1.6.0",
      "@fastify/accepts": "4.3.0",
      "@fastify/cors": "8.5.0"
    }
  }
}
